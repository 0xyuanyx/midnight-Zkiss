{
  "name": "midnight-zkiss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "contract",
    "e2e",
    "web",
    "backend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w web --",
    "build": "npm run build -w web",
    "build:vercel": "npm run build && node scripts/prepare-vercel-output.mjs",
    "preview": "npm run preview -w web --",
    "test:web": "npm test -w web --",
    "compact": "npm run compact -w contract",
    "test": "npm test -w contract",
    "devnet:up": "docker compose -f devnet.yml up -d --wait",
    "devnet:down": "docker compose -f devnet.yml down -v",
    "e2e": "npm test -w e2e",
    "backend:dev": "npm run dev -w backend",
    "backend:worker": "npm run worker -w backend",
    "backend:test": "npm test -w backend",
    "backend:typecheck": "npm run typecheck -w backend",
    "backend:db:up": "docker compose -f backend-compose.yml up -d --wait",
    "backend:db:migrate": "npm run db:migrate -w backend",
    "backend:db:seed": "npm run db:seed -w backend",
    "prepare:sns-assets": "node scripts/prepare-sns-assets.mjs",
    "test:sns": "npm run test:sns --prefix midnight",
    "sns:test-server": "node --import tsx backend/integration/sns-server.ts",
    "sns:setup": "node --import tsx scripts/sns-local.ts setup",
    "sns:api": "node --import tsx scripts/sns-local.ts api",
    "sns:worker": "node --import tsx scripts/sns-local.ts worker"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "smoldot": "npm:@aspect-build/empty@0.0.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}
