{
  "name": "midnight-zkiss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "contract",
    "e2e"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compact": "npm run compact -w contract",
    "test": "npm test -w contract",
    "devnet:up": "docker compose -f devnet.yml up -d --wait",
    "devnet:down": "docker compose -f devnet.yml down -v",
    "e2e": "npm test -w e2e"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "smoldot": "npm:@aspect-build/empty@0.0.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}
