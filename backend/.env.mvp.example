# Copy to backend/.env and fill in actual values. Never commit backend/.env.
# Open entry is independent of real SNS approval: no user wallet or event selector.
ADMISSION_MODE=open
ZKISS_MODE=real
DATABASE_URL=
SECURE_COOKIES=true
PUBLIC_ORIGIN=https://your-service.example
HOST=0.0.0.0
PORT=3001
WEB_DIST_DIR=../web/dist

AI_MODE=real
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
AI_TIMEOUT_MS=120000

# Supply the actual Midnight team's modules and deployed event scope.
# These values alone do not implement the missing walletless browser/relay integration.
MIDNIGHT_ADAPTER_MODULE=
MIDNIGHT_OPERATOR_MODULE=
MIDNIGHT_NETWORK=
MIDNIGHT_CONTRACT_ADDRESS=
MIDNIGHT_EVENT_SCOPE=
# DATABASE_CA_PEM=  # Only if required by your PostgreSQL provider.
