# Dedicated local SNS MVP database only; do not point migration/setup at the shared team DB.
DATABASE_URL=postgres://zkiss:local-development-only@127.0.0.1:55432/zkiss?options=-c%20search_path%3Dsns_mvp
ZKISS_MODE=real
ADMISSION_MODE=open
MIDNIGHT_PROTOCOL=zkiss-sns-v1
DEFAULT_EVENT_ID=evt_sns_mvp
AUTO_CREATE_EVENT=false
SECURE_COOKIES=true
PUBLIC_ORIGIN=https://127.0.0.1:5176
PORT=3003
AI_MODE=real
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
AI_TIMEOUT_MS=120000
MIDNIGHT_ADAPTER_MODULE=/absolute/repository/midnight/sns/adapter.module.ts
MIDNIGHT_OPERATOR_MODULE=/absolute/repository/midnight/sns/operator.module.ts
MIDNIGHT_NETWORK=undeployed
MIDNIGHT_CONTRACT_ADDRESS=
MIDNIGHT_EVENT_SCOPE=
MIDNIGHT_CONTRACT_ALLOWLIST=
MIDNIGHT_OPERATOR_SECRET=
MIDNIGHT_OPERATOR_WALLET_SEED=
MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v3/graphql
MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v3/graphql/ws
MIDNIGHT_NODE_URL=http://127.0.0.1:9944
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
