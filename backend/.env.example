# 백엔드 로컬 실행용 예시. 이 파일을 backend/.env로 복사합니다.
# 저장소 루트에서 npm run backend:dev / npm run backend:worker 실행 시 읽습니다.
# 실제 .env는 Git에 올리지 않습니다. 프론트만 작업하는 팀원에게 DB/AI 비밀값은 불필요합니다.

# [필수] 참가 인증 모드: demo=모의 인증, real=실제 Midnight 공급자 연결 필요.
# real로 바꾸기만 해서는 실제 인증이 구현되지 않습니다.
ZKISS_MODE=demo

# [필수] PostgreSQL 연결 문자열. 아래 값은 backend-compose.yml의 로컬 개발 DB 전용입니다.
# 실제 DB는 앱 전용 계정을 별도 전달받아 사용합니다. 관리자 계정을 쓰지 않습니다.
DATABASE_URL=postgres://zkiss:local-development-only@127.0.0.1:55432/zkiss
# [선택: DB TLS 인증서 필요 시] PEM 인증서. 줄바꿈은 \n으로 표현할 수 있습니다.
# DATABASE_CA_PEM="<DB 제공자의 CA PEM>"

# [선택] 서버 수신 주소와 포트. 로컬 기본값입니다.
HOST=127.0.0.1
PORT=3001

# [필수 확인] 로컬 HTTP는 false, 공개 HTTPS 및 real 모드는 true를 사용합니다.
SECURE_COOKIES=false
# [필수 확인] 브라우저에서 접속하는 웹의 출처(scheme://host:port).
# 아래는 API 서버가 웹도 제공할 때의 예시입니다.
# Vite를 127.0.0.1:5173에서 사용하면 http://127.0.0.1:5173으로 바꿉니다.
PUBLIC_ORIGIN=http://127.0.0.1:3001

# [선택] 세션 유효 시간(시간). 기본값 12, 허용 범위 1~168.
SESSION_HOURS=12
# [선택] Gemini 호출별 제한 시간(ms). 기본값 120000; 일시적 실패는 최대 2회 재시도.
AI_TIMEOUT_MS=120000
# [선택] 세션 생성 요청 제한 설정. 기본값 30. 전체 API의 전역 제한과는 별개입니다.
SESSION_RATE_LIMIT=30

# [선택: 실제 Gemini 분석] .env.gemini.example의 항목을 backend/.env에 합칩니다.
# AI_MODE는 참가 인증 모드와 별개입니다. demo 인증 + real AI 조합도 가능합니다.
# [실제 Gemini 필수] AI_MODE=real로 지정합니다. 모의 분석은 demo입니다.
# AI_MODE=real
# [실제 Gemini 필수·비밀] 비공개로 발급받은 서버용 API 키.
# GEMINI_API_KEY=
# [실제 Gemini 필수] 프로젝트에서 호출 가능한 이미지 입력 지원 모델 ID.
# GEMINI_MODEL=

# [선택: API에서 웹도 제공] npm run build 후 web/dist의 절대 경로.
# 별도 Vite 개발 서버만 쓰면 생략합니다. API 프로세스가 읽습니다.
# WEB_DIST_DIR=/absolute/path/to/midnight-Zkiss/web/dist

# [선택: 별도 AI 공급자] 신뢰하는 로컬 모듈의 절대 경로. Gemini 기본 연동에는 불필요.
# AI_PROVIDER_MODULE=/absolute/path/to/ai-provider.ts

# ── 실제 Midnight 연결: API와 worker의 공통 환경 ──
# 아래 항목은 real 모드 연결 시 활성화합니다. midnight/.env는 백엔드가 자동 로드하지 않습니다.
# midnight/.env.example의 공통 네트워크·주소·capabilities·allowlist를 이 파일에도 합칩니다.
# 계약 주소와 eventScope는 행사 DB 설정이며 프론트 환경변수가 아닙니다.

# [real 필수: API/worker] 참가·승인 거래를 읽고 검증하는 adapter 모듈.
# 본인 저장소 위치에 맞는 절대 경로로 바꿉니다.
# MIDNIGHT_ADAPTER_MODULE=/absolute/path/to/midnight-Zkiss/midnight/src/node/adapter.module.ts

# [real 필수: worker] 티켓 발급·방 등록을 수행하는 operator 모듈.
# worker 환경에 midnight/.env.example의 MIDNIGHT_OPERATOR_* 3개도 주입합니다.
# API는 이 모듈을 로드하지 않습니다. 운영자 비밀은 worker 환경에만 둡니다.
# MIDNIGHT_OPERATOR_MODULE=/absolute/path/to/midnight-Zkiss/midnight/src/node/operator.module.ts

# [실제 브라우저 거래 필수: API] Local Devnet(undeployed) 전용 거래 대납 모듈.
# 본인 저장소 위치의 절대 경로로 지정합니다. 프론트에는 전달하지 않습니다.
# MIDNIGHT_RELAY_MODULE=/absolute/path/to/midnight-Zkiss/midnight/src/node/relay.module.ts

# [대납 필수: API/비밀] 별도로 준비하고 충전한 수수료 지갑의 seed(hex).
# 운영자와 동일 지갑을 별도 프로세스로 동시에 구동하지 않습니다. 실제 값은 비공개 전달.
# MIDNIGHT_RELAY_WALLET_SEED=

# [같은 origin 인덱서 연결 필수: API] API 서버에서 접근 가능한 내부 GraphQL HTTP 주소.
# 로컬 Devnet 기본값 아래 참조. 프록시가 HTTP/WS를 모두 처리합니다.
# MIDNIGHT_INDEXER_PROXY_URL=http://127.0.0.1:8088/api/v3/graphql

# [선택: API] 브라우저에 알려줄 인덱서 HTTP 경로. 아래가 기본값입니다.
# 내부 서버 주소 대신 위 프록시의 같은 origin 경로를 권장합니다.
# MIDNIGHT_BROWSER_INDEXER_URL=/midnight-indexer/api/v3/graphql

# [선택: API] 브라우저에 알려줄 인덱서 WebSocket 경로. 아래가 기본값입니다.
# HTTPS 페이지에서는 브라우저가 같은 origin의 wss URL로 변환합니다.
# MIDNIGHT_BROWSER_INDEXER_WS_URL=/midnight-indexer/api/v3/graphql/ws
