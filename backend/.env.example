# Local demonstration only. Copy to backend/.env. npm workspace scripts run there.
ZKISS_MODE=demo
DATABASE_URL=postgres://zkiss:local-development-only@127.0.0.1:55432/zkiss
HOST=127.0.0.1
PORT=3001
SECURE_COOKIES=false
PUBLIC_ORIGIN=http://127.0.0.1:3001
SESSION_HOURS=12
AI_TIMEOUT_MS=30000
SESSION_RATE_LIMIT=30
# Real: ZKISS_MODE=real, SECURE_COOKIES=true, PUBLIC_ORIGIN=https://your-host
# Trusted local modules export a default provider object; absolute paths recommended.
# MIDNIGHT_ADAPTER_MODULE=/absolute/path/to/midnight-adapter.ts
# Worker only; API never imports this secret-bearing module.
# MIDNIGHT_OPERATOR_MODULE=/absolute/path/to/midnight-operator.ts
# AI_PROVIDER_MODULE=/absolute/path/to/ai-provider.ts
