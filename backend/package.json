    "smoke": "tsx src/smoke.ts",
    "test:devnet": "node --experimental-import-meta-resolve --import tsx integration/real-devnet.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "^10.1.4",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "ws": "^8.21.0",
    "zod": "4.6.5"
  }
