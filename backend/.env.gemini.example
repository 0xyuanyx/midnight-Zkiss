# Server-side only. Merge into backend/.env; this file is not loaded automatically.
AI_MODE=real
GEMINI_API_KEY=
# Image-understanding model for Korean impression text.
GEMINI_MODEL=
# Image-generation model supporting generateContent and IMAGE output.
GEMINI_IMAGE_MODEL=
# Covers text analysis and image generation together (maximum: 300000).
AI_TIMEOUT_MS=120000
