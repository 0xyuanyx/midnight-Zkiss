# 실제 Gemini 사진 분석이 필요한 백엔드 담당자용 추가 설정입니다.
# 아래 항목을 backend/.env에 합치고 같은 이름의 기존 항목은 교체합니다.
# .env.gemini 파일을 따로 만들기만 하면 기본 실행 명령에서는 자동 로드되지 않습니다.
# 프론트 VITE_ 변수에 키를 넣지 않습니다. 실제 키는 Git에 올리지 않습니다.

# [필수: 실제 AI 사용 시] real=실제 공급자 호출. 참가 인증 ZKISS_MODE와 별개입니다.
AI_MODE=real
# [필수: Gemini 사용 시] 본인 프로젝트에서 발급하거나 비공개로 전달받은 서버용 API 키.
GEMINI_API_KEY=
# [필수: Gemini 사용 시] 해당 프로젝트에서 사용 가능한 이미지 입력 지원 모델 ID.
# 모델 이름만 임의로 지정하지 말고 실제 호출 가능 여부를 확인합니다.
GEMINI_MODEL=
# [선택] 분석 제한 시간(ms). 이 예시는 60초입니다. backend/.env의 기존 항목을 교체합니다.
AI_TIMEOUT_MS=60000
