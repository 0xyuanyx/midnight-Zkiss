# Midnight 담당자용 Local Devnet 설정 예시. midnight/.env로 복사합니다.
# CLI는 자동 로드하지 않습니다. midnight 폴더에서 아래 명령으로 명시적으로 읽습니다.
# node --env-file=.env --import tsx scripts/deploy-event.ts --event-end <미래 ISO 시각>
# API/worker는 이 파일을 읽지 않습니다. 필요한 항목을 backend/.env 또는 실행 환경에 합칩니다.
# 실제 .env/지갑 seed/운영자 비밀은 Git이나 프론트 VITE_ 변수에 넣지 않습니다.

# [공통: API/worker/CLI] 네트워크 ID. 현재 대납과 검증 대상은 Local Devnet undeployed입니다.
MIDNIGHT_NETWORK=undeployed

# [공통] 서버에서 접근할 인덱서 GraphQL HTTP 주소. devnet.yml 기본 포트는 8088.
MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v3/graphql

# [대납/worker/CLI] 지갑 동기화용 인덱서 WebSocket 주소. 인덱서 설정에서 확인합니다.
MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v3/graphql/ws

# [대납/worker/CLI] 거래 제출용 노드 RPC 주소. devnet.yml 기본 포트는 9944.
MIDNIGHT_NODE_URL=http://127.0.0.1:9944

# [대납/worker/CLI] 서버 지갑·운영자 증명용 서버 주소. devnet.yml 기본 포트는 6300.
# 참가자의 비밀 witness 증명은 브라우저에서 실행되며 이 서버에 보내지 않습니다.
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

# [adapter: API/worker] 활성 기능 목록(쉼표 구분). 미지정 시 모두 비활성.
# anonymousReveal은 추가하지 않습니다. admission/reveal도 실제 계약·설정이 필요합니다.
MIDNIGHT_CAPABILITIES=admission,reveal

# [adapter: 배포 후 필수 설정] 배포 출력 contractAddress(hex), 여러 계약은 쉼표 구분.
# 빈 값은 제한 없음이므로 서비스 실행 전에 새 v2 계약 주소를 지정합니다.
MIDNIGHT_CONTRACT_ALLOWLIST=

# [선택: adapter] 별도 공개 증명 manifest를 실제 제공할 때만 설정합니다.
# 현재 브라우저는 /midnight-assets를 사용하므로 기본 연결에는 필요하지 않습니다.
# MIDNIGHT_ZK_MANIFEST_URL=https://your-host/zk/manifest.json

# [worker/배포 CLI 필수·비밀] 운영자 지갑 seed(hex). 담당자가 준비한 지갑 값을 비공개 주입.
# 테스트의 공개 genesis seed는 Local Devnet 전용입니다.
MIDNIGHT_OPERATOR_WALLET_SEED=

# [worker/배포 CLI 필수·비밀] 32바이트(64자리 hex) 운영자 비밀.
# 최초 배포 전에 생성하고 백업합니다. 배포된 계약을 관리하려면 같은 값을 유지해야 합니다.
MIDNIGHT_OPERATOR_SECRET=

# [worker 선택] 운영자 private state 저장소 이름. 기본값 zkiss-operator.
# 지갑/서비스별로 분리하고 생성된 로컬 상태 파일은 비공개 보관합니다.
MIDNIGHT_OPERATOR_STATE_STORE=zkiss-operator

# [대납 필수: API/비밀] 별도로 충전한 수수료 지갑 seed(hex). 현재 undeployed만 지원.
# API 환경에 주입합니다. 운영자 지갑과 같은 seed를 별도 프로세스로 동시에 쓰지 않습니다.
MIDNIGHT_RELAY_WALLET_SEED=

# [선택: API] 브라우저 인덱서 HTTP 경로. 같은 origin 프록시의 기본 경로입니다.
MIDNIGHT_BROWSER_INDEXER_URL=/midnight-indexer/api/v3/graphql

# [선택: API] 브라우저 인덱서 WebSocket 경로. HTTPS에서는 같은 origin wss로 변환합니다.
MIDNIGHT_BROWSER_INDEXER_WS_URL=/midnight-indexer/api/v3/graphql/ws

# 모듈 경로·MIDNIGHT_INDEXER_PROXY_URL은 backend/.env.example을 참고합니다.
# 실제 백엔드 연결은 ZKISS_MODE=real, SECURE_COOKIES=true, HTTPS PUBLIC_ORIGIN도 필요합니다.
# 배포 출력 network/contractAddress/eventScope는 행사 DB에 함께 저장해야 합니다.
