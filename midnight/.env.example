# Midnight Local Devnet 연결 예시. 실제 비밀값을 넣은 파일은 Git에 올리지 않습니다.
# 이 파일을 midnight/.env로 복사합니다. Midnight CLI는 .env를 자동으로 읽지 않습니다.
# midnight 폴더에서 실행 예:
# node --env-file=.env --import tsx scripts/deploy-event.ts --event-end <미래 ISO 시각>
# 백엔드 연결 시 공통/adapter 항목을 backend/.env에 합칩니다.
# 운영자 비밀은 worker 프로세스에만 주입합니다. 프론트 VITE_ 변수에 넣지 않습니다.

# [필수 확인] 현재 검증된 네트워크는 로컬 undeployed입니다. 공개 네트워크 배포는 미검증입니다.
MIDNIGHT_NETWORK=undeployed
# [공통] 로컬 devnet.yml의 인덱서 HTTP/WebSocket, 노드, 증명 서버 주소입니다.
MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v3/graphql
MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v3/graphql/ws
MIDNIGHT_NODE_URL=http://127.0.0.1:9944
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

# [adapter] 활성 기능. 미지정 시 전부 비활성입니다. 모바일 웹 연결 완료를 뜻하지 않습니다.
MIDNIGHT_CAPABILITIES=admission,reveal
# [adapter: 배포 후 지정] 배포 결과의 계약 주소(hex). 여러 주소는 쉼표로 구분합니다.
# 빈 값은 allowlist 제한이 없는 상태이므로 사용 서비스에서는 배포 주소를 반드시 지정합니다.
MIDNIGHT_CONTRACT_ALLOWLIST=
# [선택] 공개 증명 자산 manifest URL. 자산을 실제 제공할 때만 설정합니다.
# MIDNIGHT_ZK_MANIFEST_URL=https://your-host/zk/manifest.json

# [worker/배포 CLI 전용 필수] 운영자 지갑 seed(hex). 본인 지갑 값을 비공개로 주입합니다.
# 테스트 코드의 공개 genesis seed는 로컬 Devnet 전용이며 공개 네트워크에 쓰지 않습니다.
MIDNIGHT_OPERATOR_WALLET_SEED=
# [worker/배포 CLI 전용 필수] 32바이트(64자리 hex) 운영자 비밀. 배포 후 같은 값을 보존합니다.
MIDNIGHT_OPERATOR_SECRET=
# [worker 선택] 운영자 private state 저장소 이름. 지갑/서비스별로 분리하고 비공개 보관합니다.
MIDNIGHT_OPERATOR_STATE_STORE=zkiss-operator

# [백엔드 연결 시 backend/.env에 추가] 본인 clone 위치의 절대 경로로 바꿉니다.
# MIDNIGHT_ADAPTER_MODULE=/absolute/path/to/midnight-Zkiss/midnight/src/node/adapter.module.ts
# [worker만] MIDNIGHT_OPERATOR_MODULE=/absolute/path/to/midnight-Zkiss/midnight/src/node/operator.module.ts
# 백엔드 실제 모드는 ZKISS_MODE=real 및 HTTPS 보안 쿠키 설정이 별도로 필요합니다.
